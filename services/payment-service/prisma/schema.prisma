generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIAL_REFUNDED
}

enum PaymentType {
  BOOKING
  SECURITY_DEPOSIT
  EXTENSION
  PENALTY
  OTHER
}

model Payment {
  id String @id @default(uuid())

  userId    String // auth-service user id
  bookingId String? // booking-service booking id

  type   PaymentType
  method PaymentMethod
  status PaymentStatus @default(PENDING)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("INR")

  gatewayProvider  String? // razorpay/stripe/etc
  gatewayPaymentId String? @unique
  gatewayOrderId   String? @unique
  gatewayResponse  Json?

  failureReason String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  receiptNumber String?
  capturedAt    DateTime?
  metadata      Json?

  refunds               Refund[]
  outboxEntries         PaymentOutbox[]
  webhookDeliveries     WebhookEvent[]
  /// Persisted atomically when payment becomes SUCCESS (+ booking): drives Kafka emission + low-frequency retries
  completedEventOutbound PaymentEmittedEvent?
}

/// Ledger row committed with payment SUCCESS: ensures Kafka `payment.completed` only after durable state; `emittedAt` set post-publish
model PaymentEmittedEvent {
  paymentId String @id
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// End-to-end tracing id (also logged as eventId); stable per SUCCESS ledger row.
  correlationId String @unique @default(uuid())

  createdAt DateTime  @default(now())
  emittedAt DateTime?

  emitAttempts Int    @default(0)
  lastEmitError String?

  @@index([emittedAt, createdAt])
}

/// One row per provider webhook event id — idempotent delivery + audit trail
model WebhookEvent {
  id     String @id @default(uuid())
  provider  String
  /// Stripe evt_… or Razorpay event id / content hash
  externalId String
  /// RECEIVED = accepted for processing, PROCESSED = payment updated, REJECTED_* = no state change to SUCCESS
  status     String
  paymentId  String?
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  rejectionReason String?
  createdAt  DateTime @default(now())

  @@unique([provider, externalId])
  @@index([createdAt])
  @@index([paymentId])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// **Legacy fallback** table (booking/invoice HTTP outbox). **Superseded by Kafka `payment.completed` + `PaymentEmittedEvent` retries.**
/// Kept for optional tooling / manual enqueue; polling worker disabled by default.
model PaymentOutbox {
  id        String @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind      String
  payload   Json?
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  nextAttemptAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([paymentId])
}

model Refund {
  id String @id @default(uuid())

  paymentId       String
  amount          Decimal       @db.Decimal(10, 2)
  reason          String?
  gatewayRefundId String?
  status          PaymentStatus @default(PENDING)

  processedAt DateTime?
  createdAt   DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}
