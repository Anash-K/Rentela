DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rental_platform?schema=booking
PORT=5004
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092

# Payment → booking reconciliation (Kafka consumer)
ENABLE_PAYMENT_COMPLETED_CONSUMER=true

# Inventory hold: PENDING until paid or deadline (BullMQ delayed jobs — no cron)
BOOKING_HOLD_ENABLED=true
BOOKING_HOLD_MINUTES=15
ENABLE_BOOKING_HOLD_WORKER=true

# Trusted callers: skip soft lock (immediate CONFIRMED)
# BOOKING_IMMEDIATE_CONFIRM_DEFAULT=true
