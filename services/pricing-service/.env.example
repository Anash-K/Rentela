# Copy to .env and adjust. Never commit real secrets.

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rental_platform?schema=pricing

PORT=5015
REDIS_URL=redis://localhost:6379

# Optional tuning
# PRICING_CACHE_TTL_SEC=120
# PRICING_QUOTE_MAX_DAYS=90
# PRICING_TIMEZONE=UTC

# Required for /admin/* routes (min 16 characters). Same value in requests:
#   Header: x-pricing-admin-key: <value>
#   Or:     Authorization: Bearer <value>
PRICING_ADMIN_API_KEY=dev-rental-pricing-admin-key-2026
