generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RuleType {
  BASE
  WEEKEND
  SURGE
  FESTIVAL
  LONG_RENTAL
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

// --- Auto-pricing (vehicle kind → tier → booking quote) ---

enum VehicleKind {
  BIKE
  CAR
  ERICKSHAW
  TEMPO
  LOADER
}

/** Versioned rule set; only one should be active for production quotes at a time. */
model AutoPricingRuleVersion {
  id             String    @id @default(uuid())
  versionLabel   String    @unique
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  isActive       Boolean   @default(true)
  checksumSha256 String?
  notes          String?
  createdAt      DateTime  @default(now())

  tiers AutoPricingTier[]
}

/**
 * One band per vehicle kind (CC range or capacity ceiling).
 * For TEMPO/LOADER match smallest capacityCeilingKg where vehicle.loadCapacityKg <= ceiling.
 */
model AutoPricingTier {
  id            String      @id @default(uuid())
  ruleVersionId String
  vehicleKind   VehicleKind
  segmentLabel  String
  sortOrder     Int         @default(0)

  minEngineCc       Int?
  maxEngineCc       Int?
  capacityCeilingKg Int?

  basePricePerDay          Decimal @db.Decimal(12, 2)
  includedKmPerDay        Decimal @db.Decimal(10, 2)
  extraKmPrice            Decimal @db.Decimal(10, 2)
  weekendMultiplier       Decimal @db.Decimal(5, 2) @default(1.20)
  hourlyFromDailyDivisor Int     @default(10)

  ruleVersion AutoPricingRuleVersion @relation(fields: [ruleVersionId], references: [id], onDelete: Cascade)

  @@index([ruleVersionId, vehicleKind])
}

model PricingRule {
  id String @id @default(uuid())

  name     String
  ruleType RuleType

  vehicleCategoryId String? // from vehicle-service
  branchId          String? // specific branch pricing

  pricePerHour Decimal? @db.Decimal(10, 2)
  pricePerDay  Decimal? @db.Decimal(10, 2)

  multiplier Decimal? @db.Decimal(5, 2) // e.g. 1.25 surge

  minHours Int?
  maxHours Int?

  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)

  platformFeeFlat Decimal? @db.Decimal(10, 2)
  platformFeePct  Decimal? @db.Decimal(5, 2)
  serviceFeeFlat  Decimal? @db.Decimal(10, 2)
  serviceFeePct   Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id String @id @default(uuid())

  code        String  @unique
  description String?

  discountType DiscountType
  value        Decimal      @db.Decimal(10, 2)

  minOrderAmount    Decimal? @db.Decimal(10, 2)
  maxDiscountAmount Decimal? @db.Decimal(10, 2)

  usageLimit Int?
  usedCount  Int  @default(0)

  startsAt DateTime?
  endsAt   DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
}
