generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FileStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum OwnerType {
  USER
  VEHICLE
  BOOKING
  INVOICE
  CREDIT_NOTE
  MAINTENANCE
  OTHER
}

model FileObject {
  id String @id @default(uuid())

  ownerType OwnerType
  ownerId   String

  fileName     String
  originalName String
  mimeType     String
  extension    String?

  sizeBytes Int
  bucket    String
  objectKey String @unique

  publicUrl String?
  checksum  String?

  status FileStatus @default(ACTIVE)

  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerType, ownerId])
  @@index([status])
}
